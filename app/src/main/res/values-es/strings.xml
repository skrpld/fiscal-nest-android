    <string name="onboarding_welcome_text">Un planificador de presupuesto que funciona sin conexión: sin cuenta y sin red. Todo se calcula y se guarda en este dispositivo.</string>
    <string name="onboarding_events_title">Planifica con eventos</string>
    <string name="onboarding_events_text">Añade tus ingresos, los gastos obligatorios como el alquiler y los opcionales como las suscripciones. Los eventos pueden ocurrir una vez o repetirse cada ciertos días o meses.</string>
